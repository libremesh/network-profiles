#!/bin/sh

tmpfile=$(mktemp) || exit 1
trap 'rm -f -- "$tmpfile"' EXIT

pushgateway_host=$(uci get prometheus-node-exporter-ucode.pushgateway0.host)
token=$(uci get prometheus-node-exporter-ucode.pushgateway0.token)
domain=$(uci get dhcp.@dnsmasq[0].domain)
lan_ipv4=$(uci get network.lan.ipaddr)
host=$(cat /proc/sys/kernel/hostname | tr -d '\n')

# push a subset of metrics
prometheus-node-exporter-ucode | grep \
-e scrape \
-e time \
\
-e wifi \
-e bytes \
\
-e cpu \
-e load \
\
-e openwrt \
-e uname \
\
-e location \
> "$tmpfile"

wget -qO /dev/null \
--post-file "$tmpfile" \
--header="Authorization: Basic $token" \
https://${pushgateway_host}/metrics\
/job/remote_nodes\
/domain/${domain}\
/instance/${lan_ipv4}\
/port/9090\
/host/${host}
